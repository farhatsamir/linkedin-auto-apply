# ══════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file to .env.docker on your production server and fill
# in real values. NEVER commit the filled-in version to Git.
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ─────────────────────────────────────────────────────
# In docker-compose, "db" is the service name — do not change it
# unless the service name in docker-compose.yml also changes.
DATABASE_URL=postgresql://autoapply_user:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/autoapply_db

# ── AI (Ollama) ──────────────────────────────────────────────────
# See DEPLOYMENT.md "Ollama on production" section before setting this.
OLLAMA_BASE_URL=REPLACE_BASED_ON_DEPLOYMENT_CHOICE
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=1200

# ── Browser ──────────────────────────────────────────────────────
# Must be true in any Linux container — no display is available.
BROWSER_HEADLESS=true

# ── CORS ─────────────────────────────────────────────────────────
# Your real frontend domain(s), comma-separated. No trailing slash.
CORS_ORIGINS=https://yourdomain.com

# ── Redis ────────────────────────────────────────────────────────
# In docker-compose, "redis" is the service name.
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/2

# ── Optional: environment marker for /health endpoint ─────────────
ENVIRONMENT=production